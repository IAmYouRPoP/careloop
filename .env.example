# Copy the settings you need into your host's environment variables (or a local .env loaded by your shell).
# Nothing here is required for local development.

# Required in production: a random string of 32+ characters. Signs logins and daily check-in QR codes.
JWT_SECRET=

# Set to "production" on a real host (makes JWT_SECRET mandatory).
NODE_ENV=

# Your site's public address, used in email/SMS links and QR codes, e.g. https://careloop.onrender.com
PUBLIC_URL=

# Hosted PostgreSQL (e.g. Neon). When set, the built-in database and DATA_DIR are not used.
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Time zone for "today", slot times and reminders. Hosts usually run on UTC; set this to yours.
TZ=Asia/Kolkata

# Folder for the built-in database (only when DATABASE_URL is not set).
# Default: the project's data/ folder, or %LOCALAPPDATA%\CareLoop\data when the project is in OneDrive.
DATA_DIR=

# Demo mode (default): sample patients and staff with one-click sign-ins and a public password.
# Set DEMO_MODE=off for real use: no sample people, and the first start creates one admin account.
DEMO_MODE=
# Required the first time live mode starts (an empty database). Password: 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Optional: Claude extracts symptoms from free text (red flags and department choice stay rule-based).
ANTHROPIC_API_KEY=
# CARELOOP_AI_MODEL=claude-opus-5-5

# Optional: real email. Without these, emails are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CareLoop <no-reply@example.com>

# Optional: SMS through Twilio. Without these, texts are printed to the server log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Minutes a skipped patient has to return before becoming a no-show (default 15).
GRACE_MINUTES=
